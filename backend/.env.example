# Neon PostgreSQL Connection URL
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Upstash Redis URL (use rediss:// scheme for TLS/SSL in production)
REDIS_URL=rediss://default:password@host:6379

# CCMS Backend Public URL (e.g., https://your-ccms-backend.onrender.com)
CCMS_URL=http://127.0.0.1:8000

# Allowed Frontend URL for CORS (e.g., https://your-ccms-frontend.vercel.app)
FRONTEND_URL=http://localhost:5173

# Optional Environment Name (development / production)
ENVIRONMENT=production
